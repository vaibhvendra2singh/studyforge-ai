# StudyForge AI — Environment Configuration
# Copy this file to .env and fill in your values

# ── Required ──────────────────────────────────────
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Optional ──────────────────────────────────────
FLASK_DEBUG=true
PORT=5000
